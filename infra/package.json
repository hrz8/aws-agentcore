{
  "name": "infra",
  "version": "0.1.0",
  "bin": {
    "infra": "bin/infra.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy 'Dev/*' --require-approval never",
    "deploy:prod": "cdk deploy 'Prod/*' --require-approval never",
    "diff:dev": "cdk diff 'Dev/*'"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1128.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.260.0",
    "constructs": "^10.5.0",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  }
}
