{
  "name": "infra",
  "version": "0.1.0",
  "bin": {
    "infra": "bin/infra.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy 'Dev/*' --require-approval never",
    "deploy:prod": "cdk deploy 'Prod/*' --require-approval never",
    "diff:dev": "cdk diff 'Dev/*'"
  },
  "dependencies": {
    "aws-cdk-lib": "catalog:",
    "constructs": "^10.5.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "aws-cdk": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
