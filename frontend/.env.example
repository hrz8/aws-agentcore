# Base URL of the middleware's CopilotKit runtime route. CopilotKit appends
# sub-paths (/info, /agent/<id>/run, /threads/...) under this prefix. Cross-
# origin in dev — middleware/.env CORS_ORIGIN must include this SPA's origin.
VITE_AGENT_URL=http://localhost:7890/copilotkit

# Base URL of the middleware (without path). Used by the KB upload + citation
# routes (/kb/upload, /kb/sync, /kb/jobs/:id, /kb/sign). Same host as the
# CopilotKit route above.
VITE_MIDDLEWARE_URL=http://localhost:7890
