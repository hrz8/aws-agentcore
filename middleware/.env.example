# --- Middleware runtime ---
PORT=7890

# Comma-separated list of allowed browser origins. Default matches the
# frontend dev URL. Use `*` to allow any origin (not recommended in prod).
CORS_ORIGIN=http://localhost:3456

# --- Agent backend ---
# How to call the agent:
#   plain      → plain HTTP fetch, no signing. AGENT_PLAIN_URL is anything
#                reachable without IAM (localhost in dev, internal LB, etc.).
#   agentcore  → SigV4-signed call to a deployed AgentCore Runtime ARN.
#                Uses AWS creds from the default provider chain.
AGENT_MODE=plain
AGENT_PLAIN_URL=http://localhost:5678

# Used when AGENT_MODE=agentcore (fill in once the agent is deployed).
# Get the ARN from `cdk deploy` outputs or `aws cloudformation describe-stacks`.
# AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/DemoAgentRuntime_dev
# AWS_REGION=us-east-1
# Optional. Defaults to AgentCore's "DEFAULT" endpoint when unset.
# AGENT_RUNTIME_QUALIFIER=

# --- CopilotKit runtime route ---
# Upstream endpoint the CopilotRuntime's HttpAgent forwards to. Defaults to a
# loopback into our own /chat so SigV4 + AGENT_MODE stay centralized there.
# The route is mounted at the hardcoded path /copilotkit.
# COPILOTKIT_UPSTREAM_URL=http://localhost:7890/chat

# --- Agent scope (identity + shared uploads bucket) ---
# GENESIS_* are the bootstrap identity. UPLOADS_BUCKET is shared across
# /kb/* and /skills/* — see docs/skills.md for the S3 layout.
# All three are all-or-none.
#
# GENESIS_TENANT_ID=trinitywizards
# GENESIS_AGENT_ID=simple
# UPLOADS_BUCKET=

# --- Knowledge base (used by /kb/* routes) ---
# KB-specific config. Layered on the scope above. Set BOTH KB_ID +
# KB_S3_DATA_SOURCE_ID together. Optional KB_WEB_DATA_SOURCE_ID enables /kb/web/*.
#
# KB_ID=
# KB_S3_DATA_SOURCE_ID=
# KB_WEB_DATA_SOURCE_ID=

# --- Skills (used by /skills/* routes) ---
# No extra env: skills routes ride on the agent scope above. Local dev needs
# AWS creds via AWS_PROFILE / env vars for S3 list/get/put/delete.

# --- Memory wiring (no env vars on the middleware side) ---
# Memory env (MEMORY_*) lives on the agent. Middleware only forwards two things
# downstream:
#   x-actor-id (inbound header from frontend, raw)
#   → composed actorId injected into the AG-UI body's forwardedProps.actorId
#     for memory scoping on the agent side.
#   x-amzn-bedrock-agentcore-runtime-session-id (header to AgentCore Runtime)
#   → composed as {tenant}__{agent}__{actor}__{thread} for container affinity.
# Tenant/agent slugs are hardcoded in src/routes/chat.ts for the demo —
# lift to env (or auth claims) when adding a second tenant/agent.
