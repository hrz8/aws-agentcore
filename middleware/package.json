{
  "name": "middleware",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "HTTP middleware in front of the agent — exposes /chat and proxies streaming responses",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-agent": "^3.1075.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/credential-providers": "^3.1074.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@copilotkit/runtime": "1.61.1",
    "@smithy/protocol-http": "^5.5.1",
    "@smithy/signature-v4": "^5.5.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "robots-parser": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
