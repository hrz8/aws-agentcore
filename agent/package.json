{
  "name": "agentcore-runtime",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Sentec agent runtime — Strands agents packaged for AWS Bedrock AgentCore Runtime",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:agentcore": "agentcore dev",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:build": "docker build --platform=linux/arm64 -t agentcore-runtime:dev .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env agentcore-runtime:dev"
  },
  "dependencies": {
    "@ag-ui/aws-strands": "0.2.2",
    "@ag-ui/core": "0.0.57",
    "@anthropic-ai/sdk": "0.92.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@strands-agents/sdk": "1.6.0",
    "bedrock-agentcore": "^0.3.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "openai": "6.44.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws/agentcore": "0.20.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@ag-ui/core": "0.0.57"
    }
  }
}
