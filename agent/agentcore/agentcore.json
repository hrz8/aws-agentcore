{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "agentcoreRuntime",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "agentcoreRuntime"
  },
  "runtimes": [
    {
      "name": "simple",
      "build": "Container",
      "entrypoint": "main.js",
      "codeLocation": ".",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "MODEL_PROVIDER", "value": "bedrock" },
        { "name": "BEDROCK_MODEL_ID", "value": "global.anthropic.claude-sonnet-4-6" }
      ]
    }
  ]
}
