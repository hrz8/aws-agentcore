# --- Runtime ---
# Local default 5678. In the container PORT=8080 is set by the Dockerfile to
# match the AgentCore Runtime contract — do not change that.
PORT=5678

# --- Model provider ---
# bedrock   → Amazon Bedrock (default; uses AWS creds)
# openai    → OpenAI Chat Completions API; also works for any OpenAI-compatible
#             gateway (OpenRouter, Bifrost, LiteLLM proxy, Together, Groq, ...)
#             by setting OPENAI_BASE_URL.
# anthropic → Anthropic direct API (BYOK).
MODEL_PROVIDER=bedrock

# --- Bedrock (used when MODEL_PROVIDER=bedrock) ---
# AgentCore Runtime injects creds in prod. For local dev, use your default
# AWS profile (`aws configure`) or set the three vars below.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- OpenAI / OpenAI-compatible gateway (used when MODEL_PROVIDER=openai) ---
# Leave OPENAI_BASE_URL unset for vanilla OpenAI. For gateways:
#   OpenRouter → https://openrouter.ai/api/v1
#   Bifrost    → https://<your-bifrost-host>/v1
#   LiteLLM    → http://localhost:4000/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_ID=gpt-5

# --- Anthropic direct (used when MODEL_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# --- Agent scope (identity + shared uploads bucket) ---
# GENESIS_* are the bootstrap identity baked into this container. When the
# agent catalog lands (agent-abstraction branch), per-request (tenantId,
# agentId) will arrive via forwardedProps and these env vars will fall away.
#
# UPLOADS_BUCKET is the shared S3 bucket; it holds BOTH the KB documents
# (agents/{tenantId}__{agentId}/kb/*) and the skills (agents/{tenantId}__{agentId}/skills/*).
# All three vars are all-or-none — partial is rejected at startup.
#
# GENESIS_TENANT_ID=trinitywizards
# GENESIS_AGENT_ID=simple
# UPLOADS_BUCKET=

# --- Bedrock Knowledge Base ---
# KB-specific settings. Layered on top of the agent scope above. Set BOTH
# (or neither) of KB_ID + KB_S3_DATA_SOURCE_ID. Without KB env, search_documents
# and search_web are not registered; skills still work as long as the agent
# scope is set.
#
# KB_ID is the Bedrock Knowledge Base id (10-char string from `aws bedrock-agent list-knowledge-bases`).
#
# KB_ID=
#
# KB_WEB_DATA_SOURCE_ID is set ONLY when a WebCrawler / custom-web data
# source is deployed on the KB. When set, search_web is registered.
#
# KB_WEB_DATA_SOURCE_ID=

# --- Memory ---
# MEMORY_PROVIDER selects the LTM backend:
#   agentcore → AgentCore Memory (requires MEMORY_ID + namespaces below)
#   none      → no memory wiring
#
# MEMORY_STORAGE selects the SessionManager snapshot store:
#   noop → no-op (default; AG-UI carries per-thread state, AgentCore Memory carries the
#          durable event log, so we don't snapshot in-memory state)
#
# MEMORY_ID is the AgentCore Memory resource id. Get it from CDK outputs:
#   `aws cloudformation describe-stacks` → look for `Dev-DemoAgent-MemoryId`.
#
# Namespaces are templates the SDK resolves at read time — only `{actorId}` and
# `{sessionId}` are substituted. They must match what the CDK construct provisioned.
#
# MEMORY_PROVIDER=agentcore
# MEMORY_STORAGE=noop
# MEMORY_ID=
# MEMORY_NS_FACTS=/actor/{actorId}/facts
# MEMORY_NS_PREFERENCES=/actor/{actorId}/preferences
# MEMORY_NS_SUMMARY=/actor/{actorId}/session/{sessionId}/summary
