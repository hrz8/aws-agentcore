# --- Runtime ---
# Local default 5678. In the container PORT=8080 is set by the Dockerfile to
# match the AgentCore Runtime contract — do not change that.
PORT=5678

# --- Agent catalog ---
# `yaml` loads from CATALOG_YAML_PATH; `db` routes to the (stubbed) DB catalog.
CATALOG_SOURCE=yaml
# CATALOG_YAML_PATH=agentcore/agents.yaml

# --- Bedrock ---
# Region fallback when an agent's model.bedrock.region is unset. Credentials
# are tenant vars in agents.yaml; inside AWS, omit model.bedrock.credentials
# to use the default SDK provider chain.
AWS_REGION=us-east-1
