# --- Runtime ---
# Local default 5678. In the container PORT=8080 is set by the Dockerfile to
# match the AgentCore Runtime contract — do not change that.
PORT=5678

# --- Model provider ---
# bedrock   → Amazon Bedrock (default; uses AWS creds)
# openai    → OpenAI Chat Completions API; also works for any OpenAI-compatible
#             gateway (OpenRouter, Bifrost, LiteLLM proxy, Together, Groq, ...)
#             by setting OPENAI_BASE_URL.
# anthropic → Anthropic direct API (BYOK).
MODEL_PROVIDER=bedrock

# --- Bedrock (used when MODEL_PROVIDER=bedrock) ---
# AgentCore Runtime injects creds in prod. For local dev, use your default
# AWS profile (`aws configure`) or set the three vars below.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- OpenAI / OpenAI-compatible gateway (used when MODEL_PROVIDER=openai) ---
# Leave OPENAI_BASE_URL unset for vanilla OpenAI. For gateways:
#   OpenRouter → https://openrouter.ai/api/v1
#   Bifrost    → https://<your-bifrost-host>/v1
#   LiteLLM    → http://localhost:4000/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_ID=gpt-5

# --- Anthropic direct (used when MODEL_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# --- Bedrock Knowledge Base (Pattern C: shared KB, per-agent S3 prefix) ---
# These four are injected by CDK in deployed environments — leave commented
# out for local dev. If you point local dev at a deployed KB to test the
# search_documents tool, set ALL FOUR (partial is rejected at startup).
#
# AGENT_ID identifies this agent and is substituted into the prefix template.
# KB_ID is the Bedrock Knowledge Base id (10-char string from `aws bedrock-agent list-knowledge-bases`).
# KB_DOCS_BUCKET is the S3 bucket configured as the KB's data source.
# KB_AGENT_S3_PREFIX_TEMPLATE is the per-agent scope; MUST contain `{agentId}`.
#
# AGENT_ID=demo-agent
# KB_ID=
# KB_DOCS_BUCKET=
# KB_AGENT_S3_PREFIX_TEMPLATE=s3://${KB_DOCS_BUCKET}/agents/{agentId}/
#
# KB_WEB_DATA_SOURCE_ID is set ONLY when a WebCrawler data source is deployed
# on the KB (Phase 4). When set, the search_web tool registers and scopes
# all retrievals to chunks from this data source via
# `equals(x-amz-bedrock-kb-data-source-id, ...)`. Web content is shared
# across all agents in this runtime (S3 Vectors doesn't support
# startsWith/stringContains, so per-agent URL-prefix scoping isn't possible
# without per-agent WebCrawler data sources or a different vector store).
#
# KB_WEB_DATA_SOURCE_ID=
