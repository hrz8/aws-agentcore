AWS_ACCOUNT_ID=<your-account-id>
AWS_REGION=us-east-1

PORT=5678

# s3-yaml | local-yaml | db-postgres
REGISTRY_SOURCE=local-yaml
REGISTRY_LOCAL_YAML_PATH=./agentcore/agents.yaml
# REGISTRY_S3_KEY=registry/agents.yaml
# REGISTRY_DB_URL=postgres://user:pass@localhost:5432/nd8

UPLOADS_BUCKET=<your-uploads-bucket>
KB_ID=<your-bedrock-kb-id>
# KB_WEB_DATA_SOURCE_ID=

# agentcore | sqlite | none
MEMORY_PROVIDER=sqlite
MEMORY_STORAGE=noop

# MEMORY_AGENTCORE_ID=
