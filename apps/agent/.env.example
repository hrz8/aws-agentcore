# --- Runtime ---
PORT=5678
AWS_REGION=us-east-1

# --- Registry ---
REGISTRY_SOURCE=s3-yaml
REGISTRY_S3_KEY=registry/agents.yaml
# REGISTRY_DB_URL=postgres://user:pass@host:5432/db  # only when REGISTRY_SOURCE=db-postgres

# --- Stage resources ---
UPLOADS_BUCKET=s3-bucket-name
KB_ID=SOMEID
KB_WEB_DATA_SOURCE_ID=SOMEID

# --- Memory ---
MEMORY_PROVIDER=agentcore
MEMORY_STORAGE=noop
MEMORY_ID=MemoryId-SOMEID
MEMORY_NS_FACTS=/actor/{actorId}/facts
MEMORY_NS_PREFERENCES=/actor/{actorId}/preferences
MEMORY_NS_SUMMARY=/actor/{actorId}/session/{sessionId}/summary
