AWS_ACCOUNT_ID=<your-account-id>
AWS_REGION=us-east-1

MIDDLEWARE_URL=http://localhost:7890
WIDGET_DEMO_URL=http://localhost:4174/widget-demo.html

RUN_IN_LAMBDA=false

# s3-yaml | local-yaml | db-postgres
REGISTRY_SOURCE=local-yaml
REGISTRY_LOCAL_YAML_PATH=../agent/agentcore/agents.yaml
# REGISTRY_S3_KEY=registry/agents.yaml
# REGISTRY_DB_URL=postgres://user:pass@localhost:5432/nd8

# Optional — enables KB admin panels. Set the first three together (all-or-none) or leave all commented.
# UPLOADS_BUCKET=<your-uploads-bucket>
# KB_ID=<your-bedrock-kb-id>
# KB_S3_DATA_SOURCE_ID=<your-s3-data-source-id>
# KB_WEB_DATA_SOURCE_ID=<your-web-data-source-id>   # independent — enables web-source panel
