{
  "name": "middleware",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Thin invoker in front of the AgentCore Runtime",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:lambda": "tsx scripts/build-lambda.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint targets' && exit 0"
  },
  "dependencies": {
    "@repo/kit": "workspace:*",
    "@repo/registry": "workspace:*",
    "@ag-ui/client": "0.0.57",
    "@copilotkit/runtime": "1.61.1",
    "@hono/node-server": "^2.0.8",
    "better-sqlite3": "^12.11.1",
    "dotenv": "catalog:",
    "hono": "^4.12.27",
    "rxjs": "7.8.1",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "esbuild": "^0.28.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
