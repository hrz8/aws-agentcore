AWS_ACCOUNT_ID=<your-account-id>
AWS_REGION=us-east-1

PORT=7890
CORS_ORIGIN=http://localhost:3456,http://localhost:8765
RUN_IN_LAMBDA=false

# plain | agentcore
AGENT_MODE=plain
AGENT_PLAIN_URL=http://localhost:5678
# AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:...
# AGENT_RUNTIME_QUALIFIER=

# s3-yaml | local-yaml | db-postgres
REGISTRY_SOURCE=local-yaml
REGISTRY_LOCAL_YAML_PATH=../agent/agentcore/agents.yaml
# REGISTRY_S3_KEY=registry/agents.yaml
# UPLOADS_BUCKET=<your-uploads-bucket>
# REGISTRY_DB_URL=postgres://user:pass@localhost:5432/nd8

# in-memory | sqlite | dynamodb | s3
RUNNER_TYPE=sqlite
SQLITE_DB_PATH=.data/threads.db
# THREAD_TABLE_NAME=nd8-threads-dev-<account>
# THREAD_TTL_DAYS=30
