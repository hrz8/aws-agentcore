# --- Runtime ---
PORT=7890
AWS_REGION=us-east-1
CORS_ORIGIN=http://localhost:3456,http://localhost:5200

# --- Agent backend (plain | agentcore) ---
AGENT_MODE=plain
AGENT_PLAIN_URL=http://localhost:5678
AGENT_RUNTIME_ARN=
# AGENT_RUNTIME_QUALIFIER=

# --- CopilotKit ---
COPILOTKIT_UPSTREAM_URL=http://localhost:7890/chat

# --- Registry (used by GET /scope to resolve tenant/agent names) ---
REGISTRY_SOURCE=s3-yaml
REGISTRY_S3_KEY=registry/agents.yaml
UPLOADS_BUCKET=s3-bucket-name
# REGISTRY_DB_URL=postgres://user:pass@host:5432/db  # only when REGISTRY_SOURCE=db-postgres
